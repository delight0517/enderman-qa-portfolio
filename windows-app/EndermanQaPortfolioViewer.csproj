<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EndermanQaPortfolioViewer</AssemblyName>
    <RootNamespace>EndermanQaPortfolioViewer</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyTitle>Enderman QA Portfolio Viewer</AssemblyTitle>
    <Product>Enderman QA Portfolio Viewer</Product>
    <Description>Offline viewer for the public Enderman QA case study. Not the Enderman QA Workbench.</Description>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\dist\cases.json" Link="data\cases.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\DATA-LICENSE.md" Link="DATA-LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
